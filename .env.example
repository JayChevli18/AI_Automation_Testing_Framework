APP_NAME=AI_Test_Automation
APP_VERSION=0.1.0
API_PREFIX=/api

STORAGE_ROOT=storage
UPLOADS_DIR_NAME=uploads
RUNS_DIR_NAME=runs

DEFAULT_ENVIRONMENT=beta
HEADLESS=true
STEP_TIMEOUT_MS=30000
# Retries per step (Phase 6 hardening): attempts = 1 + STEP_RETRY_MAX
STEP_RETRY_MAX=2
STEP_RETRY_DELAY_MS=400

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_S=120
OLLAMA_JSON_FORMAT=true

BETA_BASE_URL=http://localhost:3000
LIVE_BASE_URL=http://localhost:3000
DEFAULT_TIMEOUT=30000
SCREENSHOT_ON_FAILURE=true

# Live runs block click/fill/hover unless RunRequest.allow_live_mutations=true (API returns 403 otherwise).

